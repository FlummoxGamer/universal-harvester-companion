<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_2"
    android:paddingTop="10dp"
    android:paddingBottom="20dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/subtext"
        android:layout_marginBottom="14dp" />

    <LinearLayout android:id="@+id/tmSelectTabs" style="@style/UhMenuRow">
        <ImageView style="@style/UhSettingsIcon" android:src="@drawable/ic_grid_view" />
        <TextView style="@style/UhSettingsLabel" android:text="Select tabs" />
    </LinearLayout>

    <LinearLayout android:id="@+id/tmNewTab" style="@style/UhMenuRow">
        <ImageView style="@style/UhSettingsIcon" android:src="@drawable/ic_add" />
        <TextView style="@style/UhSettingsLabel" android:text="New tab" />
    </LinearLayout>

    <LinearLayout android:id="@+id/tmNewIncognito" style="@style/UhMenuRow">
        <ImageView style="@style/UhSettingsIcon" android:src="@drawable/ic_incognito" />
        <TextView style="@style/UhSettingsLabel" android:text="New Incognito tab" />
    </LinearLayout>

    <LinearLayout android:id="@+id/tmNewGroup" style="@style/UhMenuRow">
        <ImageView style="@style/UhSettingsIcon" android:src="@drawable/ic_grid_view" />
        <TextView style="@style/UhSettingsLabel" android:text="New tab group" />
    </LinearLayout>

    <LinearLayout android:id="@+id/tmCloseAll" style="@style/UhMenuRow">
        <ImageView style="@style/UhSettingsIcon" android:src="@drawable/ic_close" />
        <TextView style="@style/UhSettingsLabel" android:text="Close all tabs" />
    </LinearLayout>

    <LinearLayout android:id="@+id/tmDeleteData" style="@style/UhMenuRow">
        <ImageView style="@style/UhSettingsIcon" android:src="@drawable/ic_downloads" />
        <TextView style="@style/UhSettingsLabel" android:text="Delete browsing data" />
    </LinearLayout>
</LinearLayout>

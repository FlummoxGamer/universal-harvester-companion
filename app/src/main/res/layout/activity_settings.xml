<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/subtext"
            android:textSize="12sp"
            android:text="" />

        <Button
            android:id="@+id/btnExtensions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Extensions"
            android:backgroundTint="@color/accent_strong"
            android:textColor="@color/bg" />

        <Button
            android:id="@+id/btnLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="View logs"
            android:backgroundTint="@color/surface"
            android:textColor="@color/accent" />

        <Button
            android:id="@+id/btnAppUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Check for app update"
            android:backgroundTint="@color/accent_strong"
            android:textColor="@color/bg" />

        <Button
            android:id="@+id/btnClearState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Clear all state"
            android:backgroundTint="@color/red"
            android:textColor="@color/bg" />

    </LinearLayout>
</ScrollView>

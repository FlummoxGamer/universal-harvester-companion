<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="app.harvester.companion.home.HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_browserFragment"
            app:destination="@id/browserFragment" />
    </fragment>

    <fragment
        android:id="@+id/browserFragment"
        android:name="app.harvester.companion.browser.BrowserFragment"
        tools:layout="@layout/fragment_browser">
        <argument
            android:name="url"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/downloadsFragment"
        android:name="app.harvester.companion.data.downloads.ui.UhDownloadsFragment"
        android:label="Downloads" />

    <fragment
        android:id="@+id/downloadSettingsFragment"
        android:name="app.harvester.companion.data.downloads.ui.UhDownloadSettingsFragment"
        android:label="Download Settings" />

    <action
        android:id="@+id/action_global_downloadsFragment"
        app:destination="@id/downloadsFragment" />

    <action
        android:id="@+id/action_downloadsFragment_to_settingsFragment"
        app:destination="@id/downloadSettingsFragment" />

</navigation>

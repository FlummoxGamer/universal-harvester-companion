{
    "manifest_version": 2,
    "name": "UH Bridge",
    "version": "4.0.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "uh-bridge@harvester.app"
        }
    },
    "background": {
        "scripts": [
            "bg_rules.js",
            "bg_privacy_sync.js",
            "bg_webrequest.js",
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "cs_cosmetics.js",
                "cs_cookie_dark.js",
                "cs_media_pip.js",
                "cs_image_translate.js",
                "cs_element_picker.js",
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "permissions": [
        "nativeMessaging",
        "nativeMessagingFromContent",
        "geckoViewAddons",
        "<all_urls>",
        "tabs",
        "webNavigation",
        "webRequest",
        "webRequestBlocking",
        "privacy"
    ],
    "web_accessible_resources": [
        "inject.js",
        "scriptlets.js",
        "devtools/eruda.min.js",
        "devtools/uh_devtools_pro.js"
    ]
}

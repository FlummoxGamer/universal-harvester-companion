{
    "manifest_version": 2,
    "name": "UH Bridge",
    "version": "4.0.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "uh-bridge@harvester.app"
        }
    },
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "permissions": [
        "nativeMessaging",
        "nativeMessagingFromContent",
        "geckoViewAddons",
        "<all_urls>",
        "tabs",
        "webNavigation",
        "webRequest",
        "webRequestBlocking",
        "privacy"
    ],
    "web_accessible_resources": [
        "inject.js",
        "scriptlets.js",
        "devtools/eruda.min.js",
        "devtools/uh_devtools_pro.js"
    ]
}

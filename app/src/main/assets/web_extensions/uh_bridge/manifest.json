{
    "manifest_version": 2,
    "name": "UH Bridge",
    "version": "1.0.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "uh-bridge@harvester.app"
        }
    },
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "permissions": [
        "nativeMessaging",
        "geckoViewAddons",
        "<all_urls>",
        "tabs"
    ]
}
